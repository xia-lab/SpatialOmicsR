# Copy values into your shell environment or a private .Renviron file.
SPATIALOMICS_PROJECT_ROOT=/absolute/path/to/SpatialOmicsMSI
SPATIALOMICS_RAT_BRAIN_DIR=/absolute/path/to/rat_brain_data
SPATIALOMICS_SMA_DIR=/absolute/path/to/sma_data
SPATIALOMICS_SWISSLIPIDS_CSV=/absolute/path/to/swisslipids_species_filtered.csv
SPATIALOMICS_SWISSLIPIDS_TSV=/absolute/path/to/swisslipids_master.tsv
SPATIALOMICS_METASPACE_ANNOTATIONS=/absolute/path/to/metaspace_annotations.csv
# Opt in to slow tests that inspect local raw datasets.
SPATIALOMICS_RUN_REAL_DATA_TESTS=false
